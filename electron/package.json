{
  "name": "iracing-telemetry",
  "productName": "iRacing Telemetry Analytics",
  "version": "9.1.0",
  "description": "Professional iRacing Telemetry Analysis tool.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "Curve Hunters",
  "license": "MIT",
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.curvehunters.iracingtelemetry",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "../app.py",
      "../app_context.py",
      "../main.py",
      "../config.py",
      "../config.yaml",
      "../requirements.txt",
      "../core/**/*",
      "../services/**/*",
      "../models/**/*",
      "../plotting/**/*",
      "../ui/**/*",
      "../utils/**/*",
      "../assets/**/*",
      "!**/__pycache__/**"
    ],
    "extraResources": [
      {
        "from": "../python_embed",
        "to": "python_embed"
      }
    ]
  }
}
